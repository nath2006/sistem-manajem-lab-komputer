ikan" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fillColor=#e8eef5;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="1430" y="335" width="435" height="38" as="geometry"/></mxCell><mxCell id="c18" value="PK perbaikan_id | FK user_id → user&#xa;FK pengecekan_id?; perangkat_id_snapshot?&#xa;tindakan, hasil_perbaikan, tanggal_perbaikan" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="1430" y="373" width="435" height="118" as="geometry"/></mxCell><mxCell id="c19" value="laporan" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fillColor=#e8eef5;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="525" width="435" height="38" as="geometry"/></mxCell><mxCell id="c20" value="PK laporan_id | FK dibuat_oleh → user&#xa;jenis_laporan, periode_mulai?, periode_selesai?&#xa;file_path?, deskripsi_laporan?" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="563" width="435" height="118" as="geometry"/></mxCell><mxCell id="c21" value="pengumuman" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=19;fillColor=#e8eef5;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="500" y="525" width="435" height="38" as="geometry"/></mxCell><mxCell id="c22" value="PK id | FK created_by → user&#xa;judul, content, file_path?&#xa;created_at?, updated_at?, is_active?" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fillColor=#ff