<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="05-sequence" id="05-sequence"><mxGraphModel page="1" pageScale="1" pageWidth="1800" pageHeight="1900" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Sequence — Aksi tiket sampai verifikasi penutupan" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=27;fontStyle=1;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="25" width="1730" height="38" as="geometry"/></mxCell><mxCell id="c2" value="Skenario sukses: assign → start → resolve → close. Setiap aksi adalah permintaan HTTP dan transaksi terpisah; bukan satu transaksi panjang." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="70" width="1730" height="55" as="geometry"/></mxCell><mxCell id="c3" value="Aktor / UI" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="25" y="150" width="250" height="65" as="geometry"/></mxCell><mxCell id="c4" value="Router + verifyToken" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="375" y="150" width="250" height="65" as="geometry"/></mxCell><mxCell id="c5" value="TicketController" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="725" y="150" width="250" height="65" as="geometry"/></mxCell><mxCell id="c6" value="TicketService" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middl