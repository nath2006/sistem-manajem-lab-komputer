l;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"  ><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="1360" as="sourcePoint"/><mxPoint x="1200" y="1360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="get(user, ticket_id) — baca ulang" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="860" y="1318" width="340" height="38" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#435568;strokeWidth=1.5;fontFamily=Arial;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"  ><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="1440" as="sourcePoint"/><mxPoint x="1600" y="1440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="SELECT tiket sesuai cakupan" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="1210" y="1398" width="390" height="38" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#435568;strokeWidth=1.5;fontFamily=Arial;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"  ><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="1530" as="sourcePoint"/><mxPoint x="150" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="200 {data: format(tiket), message}" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="160" y="1488" width="690" height="38" as="geometry"/></mxCell><mxCell id="c42" value="Ulangi protokol di atas: assign (manajer / ambil sendiri) → start (worker) → resolve (worker)&#xa;→ close (manajer atau pelapor yang bukan assignee). Kirim version terbaru pada setiap aksi." style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fillColor=#e8eef5;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="1580" width="1730" height="85" as="geometry"/></mxCell><mxCell id="c43" value="Cabang kegagalan dan batas skenario" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="1720" width="1700" height="35" as="geometry"/></mxCell><mxCell id="c44" value="Kesalahan di dalam tx → rollback + release; guard memetakan status (mis. 403 hak akses, 404 cakupan, 409 konflik versi/transisi).&#xa;Tabel tiket belum tersedia → 503. Jalur create memakai TicketWorkflowService; sequence ini merinci action, bukan semua endpoint.&#xa;Sumber: backend/router/ticketRoutes.js; controllers/ticketController.js:151–156; services/ticketService.js:10–24, 118–240." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="1760" width="1730" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>