<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="04-class" id="04-class"><mxGraphModel page="1" pageScale="1" pageWidth="1700" pageHeight="1400" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Class — Struktur implementasi backend" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=27;fontStyle=1;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="25" width="1630" height="38" as="geometry"/></mxCell><mxCell id="c2" value="UML implementasi: hanya UserService / UserRepository adalah class. «factory» menghasilkan objek fungsi; bukan class domain rekaan." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="70" width="1630" height="55" as="geometry"/></mxCell><mxCell id="c3" value="«module» userController&#xa;createUser(), getAllUser()&#xa;getUserById(), updateUser(), deleteUser()" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="45" y="160" width="460" height="130" as="geometry"/></mxCell><mxCell id="c4" value="«class» UserService&#xa;repo: UserRepository&#xa;list(), detail(id), create(payload)&#xa;update(id, payload), remove(id), project(user)" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="45" y="400" width="460" height="165" as="geometry"/></mxCell><mxCell id="c5" value="«class» UserRepository&#xa;list(), getById(), getWithPassword()&#xa;getUsernameOrEmail(), create(), update()&#xa;remove(), findLabByKepala()" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFami