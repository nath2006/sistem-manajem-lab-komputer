<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="03-activity" id="03-activity"><mxGraphModel page="1" pageScale="1" pageWidth="1500" pageHeight="1860" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Activity — Penanganan tiket layanan" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=27;fontStyle=1;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="25" width="1430" height="38" as="geometry"/></mxCell><mxCell id="c2" value="Alur utama dengan cabang menunggu, validasi perbaikan, verifikasi pelapor dan pembukaan ulang." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="70" width="1430" height="55" as="geometry"/></mxCell><mxCell id="c3" value="Mulai" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="610" y="140" width="250" height="55" as="geometry"/></mxCell><mxCell id="c4" value="Pelapor membuat tiket&#xa;Validasi klasifikasi; snapshot SLA&#xa;status = new; event created" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="530" y="235" width="410" height="100" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#435568;strokeWidth=1.5;fontFamily=Arial;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"><mxPoint x="735" y="195" as="sourcePoint"/><mxPoint x="735" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="Manajer menugaskan Teknisi&#x