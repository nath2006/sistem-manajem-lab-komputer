.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="560" y="1165" width="350" height="135" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#435568;strokeWidth=1.5;fontFamily=Arial;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"><mxPoint x="735" y="1085" as="sourcePoint"/><mxPoint x="735" y="1165" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="Tutup tiket&#xa;resolved → closed" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="540" y="1400" width="390" height="80" as="geometry"/></mxCell><mxCell id="c24" value="Ya: close" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#435568;strokeWidth=1.5;fontFamily=Arial;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"><mxPoint x="735" y="1300" as="sourcePoint"/><mxPoint x="735" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="Buka ulang (reopen)&#xa;Pelapor / manajer&#xa;assigned jika ada assignee; selain itu new" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="40" y="1165" width="410" height="115" as="geometry"/></mxCell><mxCell id="c26" value="Tidak" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#435568;strokeWidth=1.5;fontFamily=Arial;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="1230" as="sourcePoint"/><mxPoint x="450" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#435568;strokeWidth=1.5;fontFamily=Arial;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c25" target="c6"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="1165" as="sourcePoint"/><mxPoint x="530" y="440" as="targetPoint"/><Array as="points"><mxPoint x="20" y="1165"/><mxPoint x="20" y="440"/></Array></mxGeometry></mxCell><mxCell id="c28" value="Kembali ke penugasan" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="45" y="450" width="390" height="35" as="geometry"/></mxCell><mxCell id="c29" value="Boleh reopen dari closed" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#435568;strokeWidth=1.5;fontFamily=Arial;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="1440" as="sourcePoint"/><mxPoint x="245" y="1280" as="targetPoint"/><Array as="points"><mxPoint x="245" y="1440"/></Array></mxGeometry></mxCell><mxCell id="c30" value="Aksi global: pembatalan&#xa;Pelapor / manajer: cancel&#xa;Dari status selain closed / cancelled&#xa;Hasil = cancelled" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="1020" y="1190" width="410" height="125" as="geometry"/></mxCell><mxCell id="c31" value="Kontrol pada setiap aksi&#xa;Token &amp; cakupan tiket; note wajib&#xa;Cek version; lock baris induk&#xa;UPDATE + event dalam transaksi&#xa;Kesalahan → rollback (400/403/404/409)" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fillColor=#f5f7fa;strokeColor=#435568;strokeWidth=1.5;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="40" y="755" width="410" height="170" as="geometry"/></mxCell><mxCell id="c32" value="Aturan tambahan yang tidak mengubah alur utama" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="1570" width="1400" height="40" as="geometry"/></mxCell><mxCell id="c33" value="Assign ulang hanya pada tiket nonterminal; jika status bukan new, status dipertahankan. Terminal: resolved, closed, cancelled.&#xa;Resolve tiket impor ditolak 409 jika temuan belum “Sudah Ditangani”; tiket tidak otomatis menyelesaikan perbaikan perangkat.&#xa;Comment tidak mengganti status; escalate sekali pada nonterminal; reclassify hanya manajer pada nonterminal.&#xa;Sumber: backend/services/ticketService.js (action); ticketWorkflowService.js (create/import); utils/ticketPolicy.js." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#17212b;" vertex="1" parent="1"><mxGeometry x="35" y="1625" width="1430" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>