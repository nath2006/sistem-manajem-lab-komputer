# Copy to .env locally; never commit actual credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME
# Use the same MySQL host/account/database as the DB_* values above.
DATABASE_URL="mysql://CHANGE_ME:CHANGE_ME@localhost:3306/CHANGE_ME"
PORT=5000
NODE_ENV=development
# Generate two independent random secrets before starting the API.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
